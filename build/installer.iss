; BBSpecs installer.
;
; Built by build\build-installer.ps1, which compiles the single-file executable
; first and then wraps it. The version is passed in rather than written here, so
; the .csproj stays the one place a version number lives.
;
; The portable download is not going away: this exists alongside it, for people
; who would rather have a Start Menu entry, an uninstaller and a fixed location
; than a file in their Downloads folder. The two are the same program.

#ifndef AppVersion
  #define AppVersion "0.0.0"
#endif

#ifndef SourceExe
  #define SourceExe "..\dist\BBSpecs-" + AppVersion + "-win-x64.exe"
#endif

#define AppName      "BBSpecs"
#define AppPublisher "BOSSx"
#define AppUrl       "https://github.com/BOSSx-00/BBSpecs"

[Setup]
; Fixed, so installing a new version replaces the old one instead of stacking
; up separate entries in Add or Remove Programs.
AppId={{8F3C21A6-5B74-4E2D-9C18-7A5D0E9B4C33}
AppName={#AppName}
AppVersion={#AppVersion}
AppVerName={#AppName} {#AppVersion}
AppPublisher={#AppPublisher}
AppPublisherURL={#AppUrl}
AppSupportURL={#AppUrl}/issues
AppUpdatesURL={#AppUrl}/releases
VersionInfoVersion={#AppVersion}

DefaultDirName={autopf}\{#AppName}
DefaultGroupName={#AppName}
DisableProgramGroupPage=no
AllowNoIcons=yes

; BBSpecs needs Administrator at runtime to read temperature sensors, and
; Program Files needs it to write to, so there is nothing to gain from
; pretending this can be a per-user install.
PrivilegesRequired=admin
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible

LicenseFile=..\LICENSE
SetupIconFile=..\src\BBSpecs\Assets\bbspecs.ico
UninstallDisplayIcon={app}\BBSpecs.exe
WizardStyle=modern

; The logo in place of Inno's generic box and disc, which says nothing about
; what is being installed. Two sizes of each are listed so the artwork stays
; sharp on a high DPI display instead of being scaled up from the small one.
; Both are generated by tools\make-wizard-images.ps1 from the app's own logo.
WizardImageFile=wizard\wizard-large.bmp,wizard\wizard-large-2x.bmp
WizardSmallImageFile=wizard\wizard-small.bmp,wizard\wizard-small-2x.bmp

OutputDir=..\dist
OutputBaseFilename=BBSpecs-Setup-{#AppVersion}

; The payload is an already-compressed single-file build, so grinding away at
; it again buys almost nothing and costs a lot of build time.
Compression=lzma2/normal
SolidCompression=no

; Lets the Restart Manager close a running copy rather than failing, or
; demanding a reboot, which also makes silent updates from inside the app work.
CloseApplications=yes
RestartApplications=no

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "Create a desktop shortcut"; GroupDescription: "Shortcuts"
Name: "startup"; Description: "Start BBSpecs with Windows, in the notification area"; GroupDescription: "Startup"; Flags: unchecked

[Files]
; Installed under a fixed name rather than the versioned one the portable build
; uses. The logon task and the Start Menu shortcut then point somewhere that
; does not move when a new version arrives.
Source: "{#SourceExe}"; DestDir: "{app}"; DestName: "BBSpecs.exe"; Flags: ignoreversion

[Icons]
Name: "{group}\{#AppName}"; Filename: "{app}\BBSpecs.exe"
Name: "{group}\Uninstall {#AppName}"; Filename: "{uninstallexe}"
Name: "{autodesktop}\{#AppName}"; Filename: "{app}\BBSpecs.exe"; Tasks: desktopicon

[Run]
; A logon task, not a Run key entry. Windows silently refuses to start anything
; from the Run key that needs elevation: no prompt appears at sign-in, it just
; never starts. A task created with the highest privileges runs without a prompt.
Filename: "{sys}\schtasks.exe"; \
  Parameters: "/Create /TN ""{#AppName}"" /TR ""\""{app}\BBSpecs.exe\"" --tray"" /SC ONLOGON /RL HIGHEST /F"; \
  Flags: runhidden; Tasks: startup

; Ticked by default on the finish page, and runs automatically after a silent
; install, which is how an in-app update comes back up afterwards.
;
; shellexec is load-bearing, not decoration. Inno runs postinstall entries as
; the original, non-elevated user, deliberately, so that installing something
; does not leave it running with administrator rights. BBSpecs asks for
; administrator in its own manifest, so the plain CreateProcess Inno would
; otherwise use fails outright with "the requested operation requires
; elevation". ShellExecute reads the manifest and elevates properly, which
; means the app starts here exactly the way it starts from the Start Menu:
; one prompt, its own, rather than inheriting the installer's rights.
Filename: "{app}\BBSpecs.exe"; Description: "Launch {#AppName}"; Flags: nowait postinstall shellexec

[UninstallRun]
Filename: "{sys}\schtasks.exe"; Parameters: "/Delete /TN ""{#AppName}"" /F"; \
  Flags: runhidden; RunOnceId: "RemoveLogonTask"

[UninstallDelete]
; The crash log, if one was ever written. Settings live in the user's AppData
; and are deliberately left alone: uninstalling is not the same as wanting your
; preferences thrown away, and a reinstall should find them again.
Type: files; Name: "{app}\crash.log"

[Code]
{
  Closes a running copy before files are touched.

  Without this, uninstalling while BBSpecs is open removes the shortcuts, the
  logon task and the uninstaller, then fails on the one file that matters and
  leaves BBSpecs.exe sitting in the install folder with nothing left to remove
  it. Inno's own CloseApplications setting is meant to cover this through the
  Restart Manager and did not, which is unsurprising for a copy started by the
  logon task: it has no window on screen for the Restart Manager to talk to.

  Deliberately not run at the start of Setup. Closing somebody's running
  application merely because they opened the installer to look at it would be
  rude, so this waits until they have committed: after Install is pressed, and
  after removal is confirmed.
}
procedure CloseRunningApp;
var
  Code: Integer;
begin
  { Asked rather than forced, so it can save its settings and take its tray
    icon with it. Only the installed name is used, so a portable copy running
    from somebody's Downloads folder is left alone. }
  if Exec(ExpandConstant('{sys}\taskkill.exe'), '/IM BBSpecs.exe', '',
          SW_HIDE, ewWaitUntilTerminated, Code) and (Code = 0) then
  begin
    Sleep(1500);

    { Then insisted upon, for a copy that was busy or had no window to receive
      the request. Harmless when it has already gone. }
    Exec(ExpandConstant('{sys}\taskkill.exe'), '/F /IM BBSpecs.exe', '',
         SW_HIDE, ewWaitUntilTerminated, Code);
    Sleep(400);
  end;
end;

procedure CurStepChanged(CurStep: TSetupStep);
begin
  if CurStep = ssInstall then
    CloseRunningApp;
end;

procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
begin
  if CurUninstallStep = usUninstall then
    CloseRunningApp;
end;
